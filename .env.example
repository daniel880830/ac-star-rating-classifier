# Copy to .env and adjust. Real environment variables take precedence.
APP_PROFILE=default
APP_DATA_PATH=data/raw/ac_2025_09_14.csv
APP_MODEL_PATH=models/model.rds
APP_REPORTS_DIR=reports
APP_HOST=127.0.0.1
APP_PORT=8080
APP_MAX_BATCH_SIZE=1000
APP_LOG_LEVEL=INFO
# Host port published by docker compose (the container always listens on 8000)
API_HOST_PORT=8080
